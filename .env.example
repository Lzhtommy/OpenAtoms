OA_BASIC_MODEL=oa-mock
# Any OpenAI-compatible endpoint (LiteLLM proxy, OpenAI, DeepSeek, Moonshot...)
OA_LLM_BASE_URL=http://localhost:4000/v1
OA_LLM_API_KEY=
