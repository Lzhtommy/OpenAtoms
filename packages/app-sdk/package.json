{
  "name": "@oa/app-sdk",
  "version": "0.1.0",
  "description": "Client SDK for apps generated by OpenAtoms (Cloud BaaS: auth, entities, storage, ai)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/sync-template.mjs",
    "sync-template": "node scripts/sync-template.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": { "typescript": "^5.6.3" }
}
